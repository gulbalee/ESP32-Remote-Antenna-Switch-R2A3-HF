// ============================================================
// WEB ROUTES
// ============================================================

void handleR1A1()
{
    setRadio1(0);
    server.sendHeader("Location", "/");
    server.send(303);
}

void handleR1A2()
{
    setRadio1(1);
    server.sendHeader("Location", "/");
    server.send(303);
}

void handleR1A3()
{
    setRadio1(2);
    server.sendHeader("Location", "/");
    server.send(303);
}

void handleR1Off()
{
    setRadio1(-1);
    server.sendHeader("Location", "/");
    server.send(303);
}


void handleR2A1()
{
    setRadio2(0);
    server.sendHeader("Location", "/");
    server.send(303);
}

void handleR2A2()
{
    setRadio2(1);
    server.sendHeader("Location", "/");
    server.send(303);
}

void handleR2A3()
{
    setRadio2(2);
    server.sendHeader("Location", "/");
    server.send(303);
}

